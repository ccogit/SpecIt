ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000
# Optional: UI-Layouts mit Google Stitch (https://stitch.withgoogle.com → Einstellungen → API-Schlüssel)
STITCH_API_KEY=

# Performance experiment (off by default): Haiku 5.5 + low effort for spec and features.
SPECIT_FAST_MODE=0
# Optional stage-specific model / reasoning effort overrides:
# SPECIT_FINAL_MODEL=claude-sonnet-5-5
# SPECIT_FINAL_EFFORT=low
# SPECIT_FEATURE_MODEL=claude-haiku-5-5
# SPECIT_FEATURE_EFFORT=low
# SPECIT_AI_EFFORT=low

# Experimental: independently write the 8 core chapters in 3 parallel API calls.
# Requires ANTHROPIC_API_KEY; higher concurrent load / quality check recommended.
SPECIT_PARALLEL_SPEC=0

# In the SpecIt UI choose 'Vorbereitet' for speculative full-document preloading.
# Requires ANTHROPIC_API_KEY. No automatic preloading in other modes.
